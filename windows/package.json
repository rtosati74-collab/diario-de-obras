{
  "name": "relatorio-de-obra",
  "version": "1.0.0",
  "private": true,
  "description": "Relatório de andamento de obra a partir do Diário de Obra",
  "author": "Freire Tosati Engenharia",
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "chart.js": "4.5.1",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "firebase": "11.10.0",
    "jspdf": "3.0.4"
  },
  "build": {
    "appId": "br.com.freiretosati.relatoriodeobra",
    "productName": "Relatório de Obra",
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "RelatorioDeObra-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Relatório de Obra"
    },
    "npmRebuild": false
  }
}
